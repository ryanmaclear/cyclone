[Unit]
Description=Cyclone Pi Server
After=network.target

[Service]
Type=simple
User=sammy
WorkingDirectory=/home/sammy/cyclone
Environment=NODE_ENV=production
Environment=CYCLONE_HOST=0.0.0.0
Environment=CYCLONE_PORT=8080
ExecStart=/usr/bin/npm run start:server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

